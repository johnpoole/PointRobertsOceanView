# Copy to .env and fill in. Free key from https://aisstream.io (sign up, create an API key).
# Without it, vessels are reported offline in the HUD; weather and tide still work.
AISSTREAM_API_KEY=

# Opens /admin/visitors, which lists the addresses that have connected. The
# browser asks for it as a password; any user name works. Leave it empty and
# that page stays shut.
OCEANVIEW_ADMIN_PASSWORD=

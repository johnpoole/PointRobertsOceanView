# Python proxy
.venv/
__pycache__/
*.pyc

# Secrets
.env
.env.txt
*.env.txt

# Terrain build scratch (raw tiles); the baked asset under assets/ is committed
scripts/_tiles/

# Runtime cache: the ship names read off shipfinder's panel. A named volume in
# Docker (docker-compose.yml), a plain directory when the proxy runs from a
# checkout. Never committed — a missing name is simply fetched again.
data/

# Per-host compose settings, for a machine that needs to differ from
# docker-compose.yml without the difference showing up as a local modification.
docker-compose.override.yml

# The marina detector's weights. The Dockerfile fetches them into the image and
# checks their hashes; 23 MB of model does not belong in the history.
models/

# Fetched by src/test-sun.mjs off the URL the importmap pins.
assets/vendor/

# Local video references never belong in Git (including uppercase extensions).
*.[mM][pP]4
*.[mM][oO][vV]
*.[mM]4[vV]
*.[wW][eE][bB][mM]
*.[aA][vV][iI]
*.[mM][kK][vV]
*.[mM][pP][gG]
*.[mM][pP][eE][gG]
*.[mM][tT][sS]
*.[mM]2[tT][sS]
*.3[gG][pP]
*.[oO][gG][vV]
*.[wW][mM][vV]
*.[vV][oO][bB]
# The reference ZIP contains videos; the motion photo may contain video too.
kitesurf/*
!kitesurf/README.md
